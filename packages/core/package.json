{
  "name": "tsgonest",
  "version": "0.0.1",
  "description": "TypeScript compiler with runtime validation, serialization, and OpenAPI generation for NestJS",
  "keywords": [
    "typescript",
    "nestjs",
    "validation",
    "serialization",
    "openapi",
    "typescript-go",
    "tsgo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsgonest/tsgonest"
  },
  "files": [
    "bin/",
    "!bin/tsgonest-native",
    "dist/"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "tsgonest": "bin/tsgonest"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "build:migrate": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tsgonest/runtime": "workspace:*",
    "@tsgonest/types": "workspace:*",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "ts-morph": "^27.0.2",
    "tsdown": "^0.22.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@tsgonest/cli-darwin-arm64": "workspace:*",
    "@tsgonest/cli-darwin-x64": "workspace:*",
    "@tsgonest/cli-linux-arm64": "workspace:*",
    "@tsgonest/cli-linux-x64": "workspace:*",
    "@tsgonest/cli-win32-arm64": "workspace:*",
    "@tsgonest/cli-win32-x64": "workspace:*"
  }
}

{
  "openapi": "3.2.0",
  "info": { "title": "Advanced Types API", "version": "1.0.0" },
  "paths": {
    "/animals": {
      "get": {
        "operationId": "getAnimal",
        "x-tsgonest-controller": "AnimalsController",
        "x-tsgonest-method": "getAnimal",
        "tags": ["Animals"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Animal" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Animal": {
        "oneOf": [
          { "$ref": "#/components/schemas/Dog" },
          { "$ref": "#/components/schemas/Cat" }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "dog": "#/components/schemas/Dog",
            "cat": "#/components/schemas/Cat"
          }
        }
      },
      "Dog": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "breed": { "type": "string" },
          "barkVolume": { "type": "number", "readOnly": true }
        },
        "required": ["type", "breed", "barkVolume"]
      },
      "Cat": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "color": { "type": "string" },
          "indoor": { "type": "boolean", "default": true }
        },
        "required": ["type", "color"]
      },
      "NullableField": {
        "type": "object",
        "description": "Schema with nullable fields",
        "properties": {
          "name": { "type": "string" },
          "bio": { "type": ["string", "null"] },
          "legacyField": { "type": "string", "nullable": true },
          "oldApi": { "type": "string", "deprecated": true, "description": "Use newApi instead" }
        },
        "required": ["name"]
      },
      "Coordinate": {
        "type": "array",
        "prefixItems": [
          { "type": "number" },
          { "type": "number" }
        ]
      },
      "StatusEnum": {
        "type": "string",
        "description": "Task status values",
        "enum": ["pending", "in-progress", "completed", "archived"]
      }
    }
  }
}
